  "scripts": {
    "prebuild": "node -e \"try{require('fs').unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "node -e \"try{require('fs').unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "setup:gcs": "node setup-gcs-bucket.js",
    "migrate:s3-to-gcs": "node migrate-s3-to-gcs.js",
    "start:dev:google": "STORAGE_PROVIDER=google npm run start:dev",
    "start:dev:aws": "STORAGE_PROVIDER=aws npm run start:dev",
    "start:dev:local": "STORAGE_PROVIDER=local npm run start:dev",
    "test:storage": "node test-public-apis.js",
    "validate:env": "ts-node src/config/validate-environment.ts",
    "security:check": "npm run validate:env",
    "generate:id-card": "ts-node -r tsconfig-paths/register generate-sample-id.ts"
  },
